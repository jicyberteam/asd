    <style amp-custom>

        /* =====================================
           RESET
        ====================================== */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;

            width: 100%;
            height: 100%;

            overflow: hidden;

            background: #000;

            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }

        body {
            color: #fff;
        }


        /* =====================================
           FULL SCREEN
        ====================================== */

        .reels {

            position: relative;

            width: 100%;

            height: 100vh;
            height: 100dvh;

            min-height: 0;

            overflow: hidden;

            background: #000;
        }


        /* =====================================
           BANNER
        ====================================== */

        .background {

            position: absolute;

            inset: 0;

            width: 100%;
            height: 100%;

            z-index: 1;

            overflow: hidden;
        }

        .background amp-img {

            width: 100%;
            height: 100%;
        }

        .background amp-img img {

            width: 100%;
            height: 100%;

            object-fit: cover;
            object-position: center center;
        }


        /* =====================================
           GRADIENT OVERLAY
        ====================================== */

        .overlay {

            position: absolute;

            inset: 0;

            z-index: 2;

            pointer-events: none;

            background:

                linear-gradient(
                    to bottom,
                    rgba(0,0,0,.08) 0%,
                    rgba(0,0,0,.03) 38%,
                    rgba(0,0,0,.15) 55%,
                    rgba(0,0,0,.90) 100%
                );
        }


        /* =====================================
           TOP LIVE
        ====================================== */

        .top {

            position: absolute;

            z-index: 5;

            top: max(12px, env(safe-area-inset-top));

            left: 14px;
            right: 14px;

            display: flex;

            align-items: center;

            justify-content: space-between;
        }

        .live {

            display: flex;

            align-items: center;

            gap: 6px;

            padding: 6px 10px;

            border-radius: 20px;

            background:
                rgba(0,0,0,.55);

            font-size: 10px;

            font-weight: 700;

            backdrop-filter: blur(8px);
        }

        .dot {

            width: 7px;
            height: 7px;

            flex: 0 0 7px;

            border-radius: 50%;

            background: #ff1744;
        }


        /* =====================================
           BOTTOM CONTENT
        ====================================== */

        .content {

            position: absolute;

            z-index: 5;

            left: 14px;
            right: 14px;

            bottom:
                max(
                    14px,
                    env(safe-area-inset-bottom)
                );

            text-align: left;
        }


        /* =====================================
           LOGO
        ====================================== */

        .logo {

            width: 100px;

            height: 48px;

            margin-bottom: 3px;

            display: flex;

            align-items: center;
        }

        .logo amp-img {

            max-width: 100px;
            max-height: 48px;
        }


        /* =====================================
           TITLE
        ====================================== */

        .title {

            margin: 0 0 4px;

            font-size:
                clamp(
                    19px,
                    5.5vw,
                    27px
                );

            line-height: 1.15;

            font-weight: 800;

            letter-spacing: .2px;

            text-shadow:
                0 2px 8px rgba(0,0,0,.7);
        }


        /* =====================================
           DESCRIPTION
        ====================================== */

        .description {

            width: 100%;

            max-width: 390px;

            margin: 0 0 11px;

            font-size:
                clamp(
                    10px,
                    2.8vw,
                    13px
                );

            line-height: 1.4;

            color:
                rgba(255,255,255,.88);

            text-shadow:
                0 1px 5px rgba(0,0,0,.8);
        }


        /* =====================================
           BUTTON
        ====================================== */

        .buttons {

            display: flex;

            width: 100%;

            max-width: 400px;

            gap: 8px;
        }

        .button {

            flex: 1;

            min-width: 0;

            height:
                clamp(
                    38px,
                    10vw,
                    47px
                );

            display: flex;

            align-items: center;

            justify-content: center;

            padding:
                0 10px;

            border-radius: 10px;

            text-decoration: none;

            font-size:
                clamp(
                    11px,
                    3.2vw,
                    14px
                );

            font-weight: 800;

            letter-spacing: .3px;

            white-space: nowrap;
        }

        .register {

            background:
                linear-gradient(
                    135deg,
                    #ff245b,
                    #ff4d7d
                );

            color: #fff;

            box-shadow:
                0 5px 18px
                rgba(255,36,91,.35);
        }

        .login {

            background:
                rgba(255,255,255,.14);

            color: #fff;

            border:
                1px solid
                rgba(255,255,255,.42);

            backdrop-filter:
                blur(8px);
        }


        /* =====================================
           FOOTER
        ====================================== */

        .footer {

            margin-top: 6px;

            font-size: 8px;

            color:
                rgba(255,255,255,.48);
        }


        /* =====================================
           HP SANGAT PENDEK
           Contoh 568px / 600px
        ====================================== */

        @media (max-height: 650px) {

            .top {

                top: 8px;
            }

            .content {

                left: 11px;
                right: 11px;

                bottom:
                    max(
                        8px,
                        env(safe-area-inset-bottom)
                    );
            }

            .logo {

                width: 82px;
                height: 35px;

                margin-bottom: 1px;
            }

            .logo amp-img {

                max-width: 82px;
                max-height: 35px;
            }

            .title {

                font-size: 18px;

                margin-bottom: 3px;
            }

            .description {

                font-size: 9px;

                line-height: 1.3;

                margin-bottom: 7px;

                max-width: 340px;
            }

            .button {

                height: 35px;

                font-size: 11px;

                border-radius: 8px;
            }

            .footer {

                display: none;
            }
        }


        /* =====================================
           HP SANGAT KECIL
        ====================================== */

        @media (max-height: 560px) {

            .content {

                bottom:
                    max(
                        5px,
                        env(safe-area-inset-bottom)
                    );
            }

            .logo {

                display: none;
            }

            .title {

                font-size: 17px;
            }

            .description {

                display: none;
            }

            .button {

                height: 34px;
            }
        }


        /* =====================================
           HP TINGGI
        ====================================== */

        @media (min-height: 800px) and (max-width: 600px) {

            .content {

                bottom:
                    max(
                        20px,
                        env(safe-area-inset-bottom)
                    );
            }

            .logo {

                width: 115px;
                height: 55px;
            }

            .logo amp-img {

                max-width: 115px;
                max-height: 55px;
            }

            .description {

                margin-bottom: 14px;
            }
        }


        /* =====================================
           DESKTOP
        ====================================== */

        @media (min-width: 601px) {

            body {

                display: flex;

                justify-content: center;

                background: #111;
            }

            .reels {

                width: 430px;

                height: 100vh;
                height: 100dvh;

                box-shadow:
                    0 0 70px
                    rgba(0,0,0,.8);
            }

            .content {

                left: 18px;
                right: 18px;
            }
        }


        /* =====================================
           LANDSCAPE
        ====================================== */

        @media (orientation: landscape)
            and (max-height: 600px) {

            .reels {

                width: 100vw;
            }

            .content {

                left: 18px;
                right: 18px;

                bottom:
                    max(
                        8px,
                        env(safe-area-inset-bottom)
                    );
            }

            .logo {

                display: none;
            }

            .title {

                font-size: 18px;
            }

            .description {

                max-width: 55%;

                font-size: 9px;

                margin-bottom: 7px;
            }

            .buttons {

                max-width: 300px;
            }

            .button {

                height: 34px;

                font-size: 11px;
            }
        }

    </style>
</head>


